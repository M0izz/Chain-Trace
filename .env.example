# ChainTrace Environment Configuration (Example)
# Do not commit real private keys or production secrets.

# Ethereum Sepolia RPC (Chain ID: 11155111)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Polygon Amoy RPC (Chain ID: 80002)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Optional API Keys / Dedicated Providers (Infura / Alchemy)
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY
# AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Opt-in live smoke test flag
ENABLE_LIVE_SMOKE_TESTS=false
